# Client (Vite — safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_VAPID_PUBLIC_KEY=BNx...
# Required for production builds (Privacy Policy data controller — build fails if missing)
# Examples: "Jane Smith trading as NutriLog" or "NutriLog Ltd"
VITE_LEGAL_ENTITY=
VITE_SUPPORT_EMAIL=

# Dev-only: SKIP_LEGAL_ENV_CHECK=1 npm run build
# Error monitoring (Sentry — optional but recommended for production)
# Create a project at https://sentry.io — use the same DSN for client + server, or separate projects.
VITE_SENTRY_DSN=
SENTRY_DSN=
# Show "Test Sentry" in Settings on live site briefly after deploy, then remove:
# VITE_SENTRY_TEST_UI=true

# Server only (Netlify dashboard — never commit real keys)
GEMINI_API_KEY=AIza...
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite

# One code (legacy) OR several codes — use VOUCHER_CODES for multiple promos
VOUCHER_CODE=NUTRIPROMO
VOUCHER_EXPIRES=2027-07-16
# VOUCHER_CODES=NUTRIPROMO:2027-07-16:discount,VIP100:2027-12-31:topup:100,TRIAL7:2026-12-31:trial:pro:7
# Formats: CODE:YYYY-MM-DD:discount | CODE:DATE:trial:pro:DAYS | CODE:DATE:topup:SCANS

STRIPE_SECRET_KEY=sk_test_...
# Pro subscription
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_DISCOUNT_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_DISCOUNT_PRICE_ID=price_...
# Legacy fallbacks (optional)
STRIPE_PRO_PRICE_ID=price_...
STRIPE_DAILY25_PRICE_ID=price_...
# Scan packs (one-off)
STRIPE_PACK100_PRICE_ID=price_...
STRIPE_PACK100_DISCOUNT_PRICE_ID=price_...
STRIPE_PACK150_PRICE_ID=price_...
STRIPE_PACK150_DISCOUNT_PRICE_ID=price_...
# Legacy top-up price ids (map to 100-pack if unset)
STRIPE_TOPUP_PRICE_ID=price_...
STRIPE_TOPUP_DISCOUNT_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

VAPID_PUBLIC_KEY=BNx...
VAPID_PRIVATE_KEY=...
VAPID_EMAIL=mailto:REPLACE_ME@example.com

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

URL=https://your-nutrilog-site.netlify.app
CRON_SECRET=generate-a-long-random-string-for-push-cron
